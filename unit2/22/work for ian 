def rock_paper_scissors():
    user_score = 0
    cpu_score = 0
    rounds = 0

    choices = {
        1: "rock",
        2: "paper",
        3: "scissors"
    }

    while rounds < 3:
        user = input("Enter r for rock, p for paper, s for scissors, or q to quit: ").lower()

        if user == "q":
            print("Thanks for playing!")
            break

        if user not in ["r", "p", "s"]:
            print("Invalid choice. Please try again.")
            continue

        # Randomly choose rock, paper, or scissors
        cpu_number = random.randint(1, 3)
        cpu = choices[cpu_number]

        # Convert the user's letter into a word
        if user == "r":
            user_choice = "rock"
        elif user == "p":
            user_choice = "paper"
        else:
            user_choice = "scissors"

        print("You chose:", user_choice)
        print("CPU chose:", cpu)

        # Determine the winner
        if user_choice == cpu:
            print("It's a tie!")
        elif (
            (user_choice == "rock" and cpu == "scissors")
            or (user_choice == "paper" and cpu == "rock")
            or (user_choice == "scissors" and cpu == "paper")
        ):
            print("You win this round!")
            user_score += 1
        else:
            print("The CPU wins this round!")
            cpu_score += 1

        rounds += 1
        print("Your score:", user_score)
        print("CPU score:", cpu_score)
        print()

    print("Game over!")
    print("Final user score:", user_score)
    print("Final CPU score:", cpu_score)

    if user_score > cpu_score:
        print("You won the game!")
    elif cpu_score > user_score:
        print("The CPU won the game!")
    else:
        print("The game ended in a tie!")


rock_paper_scissors()
